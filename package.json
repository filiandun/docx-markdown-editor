{
  "name": "docx-markdown-editor",
  "displayName": "Docx Markdown Editor",
  "publisher": "filian",
  "description": "Preview DOCX files directly in VS Code, edit them as Markdown, and automatically synchronize changes back to the original .docx using Pandoc.",
  "version": "1.0.1",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/filiandun/docx-markdown-editor.git"
  },
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:docx.openAsMarkdown",
    "onCommand:docx.convertTo",
    "onCommand:docx.createDocx"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
            {
                "viewType": "docxMarkdownEditor.preview",
                "displayName": "DOCX Preview",
                "selector": [
                    {
                        "filenamePattern": "*.docx"
                    }
                ],
                "priority": "default"
            }
        ],
    "commands": [
      {
        "command": "docx.openAsMarkdown",
        "title": "Open as Markdown"
      },
      {
        "command": "docx.convertTo",
        "title": "Convert to.."
      },
      {
        "command": "docx.createDocx",
        "title": "New .docx.."
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "docx.openAsMarkdown",
          "when": "resourceExtname == .docx",
          "group": "navigation"
        },
        {
          "command": "docx.convertTo",
          "when": "resourceExtname == .md || resourceExtname == .docx || resourceExtname == .html || resourceExtname == .epub",
          "group": "navigation"
        },
        {
          "command": "docx.createDocx",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "tar": "^7.5.19"
  }
}
